{
  "configurations": [
    {
      "name": "PlatformIO esp32cam",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/variants/esp32",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/libraries/**",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/include/**",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/qio_qspi/include"
      ],
      "defines": [
        "ARDUINO=10812",
        "ARDUINO_ARCH_ESP32",
        "ESP32",
        "CAMERA_MODEL_AI_THINKER"
      ],
      "compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++.exe",
      "cStandard": "gnu99",
      "cppStandard": "gnu++11",
      "intelliSenseMode": "gcc-x64"
    },
    {
      "name": "PlatformIO esp32s3",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/variants/esp32s3",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/libraries/**",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/include/**",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/qio_opi/include"
      ],
      "defines": [
        "ARDUINO=10812",
        "ARDUINO_ARCH_ESP32",
        "ESP32",
        "ARDUINO_ESP32S3_DEV",
        "CAMERA_MODEL_ESP32S3_EYE",
        "BOARD_HAS_PSRAM"
      ],
      "compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp32s3/bin/xtensa-esp32s3-elf-g++.exe",
      "cStandard": "gnu99",
      "cppStandard": "gnu++11",
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
